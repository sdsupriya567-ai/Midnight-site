<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VYRO — Future Commerce</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
  --bg:#050507;
  --card:#0d0d12;
  --card2:#111117;
  --text:#fff;
  --muted:#858590;
  --line:rgba(255,255,255,.09);
  --purple:#8b5cf6;
  --cyan:#22d3ee;
  --green:#34d399;
  --danger:#fb7185;
  --shadow:0 25px 80px rgba(0,0,0,.45);
}

.light{
  --bg:#f4f4f7;
  --card:#fff;
  --card2:#f8f8fb;
  --text:#101014;
  --muted:#666673;
  --line:rgba(0,0,0,.09);
  --shadow:0 20px 60px rgba(0,0,0,.12);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  transition:.35s;
}

button,input{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  color:inherit;
  text-decoration:none;
}

/* BACKGROUND */

.bg-orb{
  position:fixed;
  width:500px;
  height:500px;
  border-radius:50%;
  filter:blur(130px);
  opacity:.12;
  pointer-events:none;
  z-index:-2;
}

.orb1{
  background:#7c3aed;
  left:-200px;
  top:100px;
}

.orb2{
  background:#06b6d4;
  right:-220px;
  bottom:0;
}

/* TOP BAR */

.topbar{
  background:linear-gradient(90deg,#7c3aed,#06b6d4,#7c3aed);
  background-size:200%;
  animation:gradientMove 5s linear infinite;
  color:white;
  text-align:center;
  padding:9px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.5px;
}

@keyframes gradientMove{
  to{background-position:200%}
}

/* NAVBAR */

.nav{
  position:sticky;
  top:0;
  z-index:1000;
  padding:18px 6%;
  display:flex;
  align-items:center;
  gap:30px;
  background:rgba(5,5,7,.72);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--line);
}

.light .nav{
  background:rgba(255,255,255,.75);
}

.logo{
  font-size:26px;
  font-weight:900;
  letter-spacing:4px;
  margin-right:auto;
}

.logo span{
  color:var(--purple);
}

.nav-links{
  display:flex;
  gap:25px;
}

.nav-links a{
  color:var(--muted);
  font-size:13px;
  transition:.25s;
}

.nav-links a:hover{
  color:var(--text);
}

.nav-actions{
  display:flex;
  gap:9px;
  align-items:center;
}

.icon-btn{
  width:42px;
  height:42px;
  border-radius:50%;
  border:1px solid var(--line);
  background:var(--card2);
  color:var(--text);
  display:grid;
  place-items:center;
  position:relative;
  transition:.3s;
}

.icon-btn:hover{
  transform:translateY(-3px);
  border-color:var(--purple);
}

.badge-count{
  position:absolute;
  top:-3px;
  right:-3px;
  min-width:18px;
  height:18px;
  border-radius:20px;
  background:var(--purple);
  color:white;
  font-size:9px;
  display:grid;
  place-items:center;
}

/* HERO */

.hero{
  min-height:700px;
  display:grid;
  place-items:center;
  text-align:center;
  padding:100px 6%;
  position:relative;
  overflow:hidden;
}

.grid-bg{
  position:absolute;
  inset:0;
  opacity:.25;
  background-image:
    linear-gradient(var(--line) 1px,transparent 1px),
    linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:70px 70px;
  mask-image:linear-gradient(to bottom,black,transparent);
}

.hero-content{
  position:relative;
  max-width:1000px;
}

.eyebrow{
  display:inline-flex;
  padding:9px 16px;
  border:1px solid rgba(139,92,246,.4);
  background:rgba(139,92,246,.08);
  color:#c4b5fd;
  border-radius:50px;
  font-size:11px;
  font-weight:700;
  letter-spacing:2px;
  margin-bottom:25px;
}

.hero h1{
  font-size:clamp(55px,10vw,130px);
  line-height:.86;
  letter-spacing:-7px;
  font-weight:900;
}

.gradient{
  background:linear-gradient(90deg,#fff,#a78bfa,#22d3ee,#fff);
  background-size:300%;
  -webkit-background-clip:text;
  color:transparent;
  animation:gradientMove 5s linear infinite;
}

.hero p{
  max-width:650px;
  margin:30px auto;
  color:var(--muted);
  line-height:1.8;
  font-size:16px;
}

.hero-buttons{
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
}

.btn{
  border:0;
  border-radius:50px;
  padding:14px 23px;
  font-weight:800;
  transition:.3s;
}

.btn-primary{
  background:white;
  color:#050507;
}

.btn-primary:hover{
  transform:translateY(-4px);
  box-shadow:0 15px 50px rgba(255,255,255,.18);
}

.btn-outline{
  background:rgba(255,255,255,.04);
  color:var(--text);
  border:1px solid var(--line);
}

.btn-outline:hover{
  border-color:var(--purple);
  transform:translateY(-4px);
}

/* FLOATING RINGS */

.ring{
  position:absolute;
  border:1px solid rgba(139,92,246,.18);
  border-radius:50%;
  animation:float 7s ease-in-out infinite;
}

.r1{
  width:180px;
  height:180px;
  left:7%;
  top:25%;
}

.r2{
  width:280px;
  height:280px;
  right:5%;
  top:18%;
  animation-delay:2s;
}

@keyframes float{
  50%{
    transform:translateY(-25px) rotate(20deg);
  }
}

/* SECTIONS */

.section{
  padding:90px 6%;
  max-width:1500px;
  margin:auto;
}

.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:30px;
}

.section-head h2{
  font-size:42px;
  letter-spacing:-2px;
}

.section-head p{
  color:var(--muted);
  margin-top:7px;
}

/* SEARCH */

.search-box{
  position:relative;
  width:280px;
}

.search-box input{
  width:100%;
  padding:13px 18px 13px 42px;
  border-radius:50px;
  border:1px solid var(--line);
  outline:none;
  background:var(--card2);
  color:var(--text);
}

.search-icon{
  position:absolute;
  left:16px;
  top:50%;
  transform:translateY(-50%);
  color:var(--muted);
}

/* FILTER */

.filters{
  display:flex;
  gap:9px;
  flex-wrap:wrap;
  margin-bottom:28px;
}

.filter{
  border:1px solid var(--line);
  background:var(--card2);
  color:var(--muted);
  padding:9px 17px;
  border-radius:50px;
  transition:.3s;
}

.filter:hover,
.filter.active{
  background:rgba(139,92,246,.12);
  color:var(--text);
  border-color:var(--purple);
}

/* PRODUCTS */

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.product{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:24px;
  padding:10px;
  position:relative;
  overflow:hidden;
  transition:.4s;
}

.product:hover{
  transform:translateY(-8px);
  border-color:rgba(139,92,246,.45);
  box-shadow:var(--shadow);
}

.product-img{
  height:300px;
  border-radius:18px;
  overflow:hidden;
  position:relative;
  background:#15151c;
}

.product-img img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.6s;
}

.product:hover img{
  transform:scale(1.08);
}

.tag{
  position:absolute;
  top:12px;
  left:12px;
  background:white;
  color:#111;
  padding:6px 10px;
  border-radius:50px;
  font-size:9px;
  font-weight:900;
  z-index:2;
}

.heart{
  position:absolute;
  right:12px;
  top:12px;
  width:38px;
  height:38px;
  border:0;
  border-radius:50%;
  background:rgba(0,0,0,.5);
  color:white;
  backdrop-filter:blur(10px);
  z-index:2;
  transition:.3s;
}

.heart:hover,
.heart.liked{
  background:#fb7185;
  transform:scale(1.1);
}

.product-info{
  padding:18px 9px 9px;
}

.product-info small{
  color:var(--muted);
  font-size:10px;
  letter-spacing:1px;
}

.product-info h3{
  font-size:17px;
  margin:7px 0;
}

.stars{
  color:#fbbf24;
  font-size:12px;
}

.rating{
  color:var(--muted);
  font-size:11px;
  margin-left:4px;
}

.price-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:15px;
}

.price{
  font-size:19px;
  font-weight:800;
}

.old-price{
  color:var(--muted);
  text-decoration:line-through;
  font-size:11px;
  margin-left:6px;
}

.add-btn{
  width:40px;
  height:40px;
  border-radius:50%;
  border:0;
  background:var(--text);
  color:var(--bg);
  font-size:22px;
  transition:.3s;
}

.add-btn:hover{
  background:var(--purple);
  color:white;
  transform:rotate(90deg);
}

/* SALE */

.sale{
  margin-top:80px;
  border:1px solid var(--line);
  border-radius:30px;
  padding:45px;
  background:
    radial-gradient(circle at 90% 50%,rgba(139,92,246,.22),transparent 35%),
    var(--card);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
  overflow:hidden;
}

.sale h2{
  font-size:45px;
  letter-spacing:-2px;
}

.sale p{
  color:var(--muted);
  margin-top:8px;
}

.countdown{
  display:flex;
  gap:9px;
}

.time{
  min-width:70px;
  padding:14px 10px;
  border-radius:16px;
  background:var(--card2);
  border:1px solid var(--line);
  text-align:center;
}

.time strong{
  display:block;
  font-size:22px;
}

.time span{
  color:var(--muted);
  font-size:9px;
}

/* FEATURE */

.feature{
  margin-top:80px;
  border-radius:30px;
  padding:65px;
  min-height:400px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:40px;
  background:
    radial-gradient(circle at 80% 30%,rgba(34,211,238,.18),transparent 25%),
    radial-gradient(circle at 20% 80%,rgba(139,92,246,.18),transparent 30%),
    var(--card);
  border:1px solid var(--line);
}

.feature h2{
  font-size:55px;
  max-width:600px;
  letter-spacing:-3px;
}

.feature p{
  color:var(--muted);
  line-height:1.8;
  max-width:520px;
  margin:20px 0;
}

.feature-art{
  width:270px;
  height:270px;
  border-radius:50%;
  background:
    radial-gradient(circle at 35% 25%,white,transparent 8%),
    radial-gradient(circle at 40% 35%,#a78bfa,#4c1d95 35%,#050507 70%);
  box-shadow:0 0 100px rgba(139,92,246,.3);
  animation:orb 5s ease-in-out infinite;
}

@keyframes orb{
  50%{
    transform:translateY(-18px) rotate(8deg);
  }
}

/* FOOTER */

footer{
  border-top:1px solid var(--line);
  padding:60px 6%;
  text-align:center;
}

.footer-logo{
  font-size:28px;
  font-weight:900;
  letter-spacing:4px;
}

footer p{
  color:var(--muted);
  font-size:12px;
  margin-top:10px;
}

/* CART DRAWER */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.6);
  backdrop-filter:blur(5px);
  z-index:1500;
  opacity:0;
  visibility:hidden;
  transition:.3s;
}

.overlay.show{
  opacity:1;
  visibility:visible;
}

.cart-drawer{
  position:fixed;
  right:0;
  top:0;
  height:100%;
  width:min(430px,100%);
  background:var(--card);
  z-index:1600;
  border-left:1px solid var(--line);
  transform:translateX(100%);
  transition:.4s;
  padding:25px;
  display:flex;
  flex-direction:column;
}

.cart-drawer.show{
  transform:translateX(0);
}

.cart-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding-bottom:20px;
  border-bottom:1px solid var(--line);
}

.close{
  width:38px;
  height:38px;
  border-radius:50%;
  border:1px solid var(--line);
  background:var(--card2);
  color:var(--text);
}

.cart-items{
  flex:1;
  overflow:auto;
  padding:20px 0;
}

.empty{
  text-align:center;
  color:var(--muted);
  padding:60px 20px;
}

.cart-item{
  display:flex;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid var(--line);
}

.cart-item img{
  width:65px;
  height:65px;
  object-fit:cover;
  border-radius:12px;
}

.cart-item-info{
  flex:1;
}

.cart-item-info h4{
  font-size:13px;
}

.cart-item-info p{
  color:var(--muted);
  font-size:12px;
  margin-top:5px;
}

.qty{
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:8px;
}

.qty button{
  width:23px;
  height:23px;
  border:1px solid var(--line);
  background:var(--card2);
  color:var(--text);
  border-radius:6px;
}

.cart-bottom{
  border-top:1px solid var(--line);
  padding-top:20px;
}

.total{
  display:flex;
  justify-content:space-between;
  font-size:18px;
  font-weight:800;
  margin-bottom:15px;
}

.checkout{
  width:100%;
  border:0;
  padding:15px;
  border-radius:15px;
  background:var(--text);
  color:var(--bg);
  font-weight:800;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  z-index:2000;
  background:rgba(0,0,0,.75);
  backdrop-filter:blur(12px);
  display:none;
  place-items:center;
  padding:20px;
}

.modal.show{
  display:grid;
}

.modal-box{
  width:min(900px,100%);
  background:var(--card);
  border:1px solid var(--line);
  border-radius:30px;
  overflow:hidden;
  display:grid;
  grid-template-columns:1fr 1fr;
  position:relative;
  animation:modalIn .35s ease;
}

@keyframes modalIn{
  from{
    opacity:0;
    transform:scale(.9) translateY(30px);
  }
}

.modal-img{
  min-height:450px;
}

.modal-img img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.modal-info{
  padding:45px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.modal-info small{
  color:var(--purple);
  letter-spacing:2px;
}

.modal-info h2{
  font-size:38px;
  margin:12px 0;
}

.modal-info p{
  color:var(--muted);
  line-height:1.8;
}

.modal-price{
  font-size:28px;
  font-weight:900;
  margin:25px 0;
}

.modal-close{
  position:absolute;
  right:15px;
  top:15px;
  width:40px;
  height:40px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(0,0,0,.5);
  color:white;
  z-index:3;
}

/* TOAST */

.toast{
  position:fixed;
  left:50%;
  bottom:25px;
  transform:translate(-50%,100px);
  background:var(--card);
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  padding:14px 20px;
  border-radius:50px;
  z-index:3000;
  opacity:0;
  transition:.35s;
}

.toast.show{
  transform:translate(-50%,0);
  opacity:1;
}

/* RESPONSIVE */

@media(max-width:1100px){
  .products{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:750px){

  .nav-links{
    display:none;
  }

  .hero{
    min-height:650px;
  }

  .hero h1{
    letter-spacing:-4px;
  }

  .section-head{
    display:block;
  }

  .search-box{
    margin-top:20px;
    width:100%;
  }

  .products{
    grid-template-columns:1fr;
  }

  .sale{
    flex-direction:column;
    align-items:flex-start;
  }

  .countdown{
    width:100%;
  }

  .time{
    flex:1;
  }

  .feature{
    flex-direction:column;
    text-align:center;
    padding:40px 25px;
  }

  .feature h2{
    font-size:38px;
  }

  .feature-art{
    width:190px;
    height:190px;
  }

  .modal-box{
    grid-template-columns:1fr;
    max-height:90vh;
    overflow:auto;
  }

  .modal-img{
    min-height:260px;
  }

  .modal-info{
    padding:30px;
  }

  .modal-info h2{
    font-size:30px;
  }
}
</style>
</head>

<body>

<div class="bg-orb orb1"></div>
<div class="bg-orb orb2"></div>

<!-- SALE BAR -->

<div class="topbar">
  ⚡ MIDNIGHT DROP — UP TO 40% OFF — LIMITED TIME ONLY
</div>

<!-- NAVBAR -->

<nav class="nav">

  <a href="#" class="logo">VY<span>RO</span></a>

  <div class="nav-links">
    <a href="#shop">Shop</a>
    <a href="#deals">Deals</a>
    <a href="#featured">Featured</a>
  </div>

  <div class="nav-actions">

    <button class="icon-btn" onclick="toggleTheme()" title="Theme">
      ◐
    </button>

    <button class="icon-btn" onclick="document.getElementById('shop').scrollIntoView()">
      ⌕
    </button>

    <button class="icon-btn" onclick="openCart()">
      🛒
      <span class="badge-count" id="cartCount">0</span>
    </button>

  </div>

</nav>


<!-- HERO -->

<section class="hero">

  <div class="grid-bg"></div>

  <div class="ring r1"></div>
  <div class="ring r2"></div>

  <div class="hero-content">

    <div class="eyebrow">
      NEXT GENERATION COMMERCE
    </div>

    <h1>
      SHOP<br>
      <span class="gradient">BEYOND.</span>
    </h1>

    <p>
      A curated collection for people who want
      better design, smarter products and
      absolutely zero boring.
    </p>

    <div class="hero-buttons">
      <a href="#shop" class="btn btn-primary">
        Explore Collection →
      </a>

      <a href="#deals" class="btn btn-outline">
        View Deals
      </a>
    </div>

  </div>

</section>


<!-- SHOP -->

<section class="section" id="shop">

  <div class="section-head">

    <div>
      <h2>Fresh Drops</h2>
      <p>Products worth adding to your world.</p>
    </div>

    <div class="search-box">
      <span class="search-icon">⌕</span>
      <input
        type="text"
        id="search"
        placeholder="Search products..."
        oninput="searchProducts()"
      >
    </div>

  </div>


  <div class="filters">

    <button class="filter active" onclick="filterProducts('all',this)">
      All
    </button>

    <button class="filter" onclick="filterProducts('tech',this)">
      Tech
    </button>

    <button class="filter" onclick="filterProducts('fashion',this)">
      Fashion
    </button>

    <button class="filter" onclick="filterProducts('accessory',this)">
      Accessories
    </button>

    <button class="filter" onclick="filterProducts('home',this)">
      Lifestyle
    </button>

  </div>


  <div class="products" id="products">

    <!-- PRODUCT 1 -->

    <article class="product"
      data-category="tech"
      data-name="Pulse X Headphones">

      <div class="product-img">

        <span class="tag">BEST SELLER</span>

        <button class="heart" onclick="toggleLike(this)">
          ♡
        </button>

        <img
          src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=900&q=85"
          alt="Headphones"
          onclick="openProduct('Pulse X Headphones',2499,this.parentElement.querySelector('img').src)"
        >

      </div>

      <div class="product-info">

        <small>TECH / 01</small>

        <h3>Pulse X Headphones</h3>

        <div>
          <span class="stars">★★★★★</span>
          <span class="rating">(248)</span>
        </div>

        <div class="price-row">

          <div class="price">
            ₹2,499
            <span class="old-price">₹3,999</span>
          </div>

          <button class="add-btn"
            onclick="addToCart('Pulse X Headphones',2499,'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80')">
            +
          </button>

        </div>

      </div>

    </article>


    <!-- PRODUCT 2 -->

    <article class="product"
